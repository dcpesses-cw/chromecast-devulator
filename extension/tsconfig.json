{
	"compilerOptions": {
		"moduleResolution": "node",
		"removeComments": false,
		"sourceMap": true,
		"target": "es2018",
		"outDir": "build",
		"declaration": true,
		"strict": true,
		"module": "esnext",
		"noEmitOnError": true,
		"lib": ["es2017", "DOM"],
		"esModuleInterop": false
	},
	"include": ["src"]
}
